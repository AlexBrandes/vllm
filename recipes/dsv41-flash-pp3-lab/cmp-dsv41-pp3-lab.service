[Unit]
Description=LAB (not installed): DeepSeek-V4.1-Flash-1017 Q4N-X EXL3 pipeline-parallel (PP3) on CMP 170HX cards 1, 3, 2
Documentation=file:/home/alex/llm-gateway/gateway/README.md
After=docker.service
Requires=docker.service
StartLimitIntervalSec=1800
StartLimitBurst=10

# LAB UNIT, committed for review only. Do NOT install or enable it: it takes cards 1, 2 and 3,
# i.e. it replaces the GLM-5.3-Flash default placement (glm53-exl3-pp2 on cards 1-2) and the
# 27B on card 3 (qwen38-c). Card 4 (qwen38-d, lab card) is never touched: the container sees only the three UUIDs below.
#
# Stage order (CUDA_VISIBLE_DEVICES order = PP rank): rank 0 = card 1 (GPU-bd10e096, 64 GB, layers 0-14,
# embedding, vision tower, both Engram layers 1 and 14), rank 1 = card 3 (GPU-a675b4e2, 40 GB, layers
# 15-24, shadow of source layer 14), rank 2 = card 2 (GPU-348909a8, 64 GB, layers 25-39, shadows of
# source layers 20 and 24, final norm, head, DSpark drafter). VLLM_PP_LAYER_PARTITION=15,10,15 cuts inside
# the KV-sharing groups 14-19 and 20-39; the plugin's shadow sources (models/deepseek_v41/sm80_pp_shadow.py)
# make that legal: stage 0 ships layer 14's attention input, stage 1 ships 20's and 24's (10 KB/token each).
# Rebalance by measured memory at first boot (valid stage sizes are any; shadows are planned automatically).
# Memory (revised c1 allocation of 2026-11-18 02:34: routed 2.5 bpw on layers 0-6 and 36-39, 2.0 on 7-35, drafter
# routed 2.0; real-shape meta build): weights 15,10,15 = 62.4 / 36.0 / 58.0 GB + DSpark drafter 4.8 GB on rank 2
# (INT8 drafter-embedding copy). Non-weight measured on card 4 (engine log 2026-11-18 01:47 and 03:35): first stage
# 2.82 GiB, last stage with DSpark 2.31 GiB, KV 2.07 / 1.49 KB per token on the first / last stage. At 0.97 the KV
# room is ~0.7 GiB on rank 0 (with VLLM_DEEPSEEK_V41_EMBED_INT8=1; ~0.1 GiB without), ~2.1 on rank 1, ~0.3 on
# rank 2: a pool of ~200k tokens, so max-model-len 131072 (engine log 03:36-04:35, ATTENTION coordinator;
# margins ±0.2 GiB). Fallbacks if
# a rank's KV line at boot is short: --max-num-batched-tokens 1024 instead of the INT8 embedding (rank 0 +0.57 GiB,
# no numerics change), 1536 (rank 2 +0.13 GiB), or a smaller max-model-len; run-lab.sh takes them as overrides.
# DSpark under PP: the plugin backbone ships target-layer streams over PP (here targets 37-39 are all on rank 2);
# PP2/PP3 runs on one card (tests/models/deepseek_v41/sm80/gpu_pp_one_card.py) match PP1 bit for bit: the tiny
# checkpoint with and without DSpark, and real converter layers 0-5 (no drafter converted yet) with these switches.
# Image: lab-dsv41-pp3:<plugin sha> built by recipes/dsv41-flash-pp3-lab/build.sh (dsv41/plugin + dsv41/vllm
# on lab-glm53-q4nx-kf:6734e9fe03). Weights:
#   /model  /home/alex/models/DeepSeek-V4.1-Flash-1017-Q4NX-c1   Q4N-X EXL3 conversion (routed 2.0/2.5 bpw)
#   /w8     /home/alex/models/DeepSeek-V4.1-Flash-1017-dense-w8-v1 dense INT8 sidecar (runtime/dsv41/dense-w8,
#           build_dense_w8.py, 8.10 GB, 664 matrices; copy with MANIFEST before first boot)
#   /engram /home/alex/models/DeepSeek-V4.1-Flash-1017-src        official shards 47-48 (Engram tables, SSD
#           placement, read through model.safetensors.index.json; config field engram_table_dir)
# Flags carried from the GLM production unit (see gateway/cmp-glm53-exl3-pp2.service for evidence):
#   Q4N-X INT8 routed prefill/decode (t2c4), wide decode calls (64 rows), combine_route wide, no route
#   re-check; dense W8A8 sidecar incl. skinny decode GEMM; homogeneous PP steps, spread decodes,
#   2048-token prefill chunk beside decodes (sched round-robin is in the plugin); expandable segments.
# DeepSeek-V4.1 specific: target input embedding (rank 0) and the drafter's copy (rank 2) as INT8 rows (-0.61 GiB
# each; the target's changes numerics slightly, judged by fidelity-v1); rotary caches cut to
# max-model-len + 4096 (-0.27 GB per cache kind); Engram SSD rows with an 8 GiB host row cache on rank 0; FP32 head (plugin
# default head_dtype=float32); deterministic index top-k is the sm_80 stable radix select (no flag);
# no hash routing (the 1017 checkpoint has no gate.tid2eid; every layer is noaux_tc sqrtsoftplus).
# mHC runs the sm_80 fused kernels (kernel A + finish v2): every BF16 layer input is bit-identical for any call size
# 1..2048 (card-4 batch-invariance check 2026-11-17), unlike the torch formulas (cuBLAS order depends on rows);
# VLLM_SM80_MHC_UNIFORM_KERNEL_A=1 makes comb identical too (decode-sized calls skip the transposed kernel; no
# measurable decode cost at real width).
# Router gate in FP64 on every call up to 2048 rows (VLLM_DEEPSEEK_V41_GATE_GEMV + _MAX_ROWS=2048): the GEMV's rows
# are independent of each other, the FP32 GEMM's tiling follows the row count and near-ties then pick other experts.
# Card 4, real converter layers 0-5: first-token logprobs alone vs batched moved by up to 3 nats with the GEMM, 0 with
# the GEMV, and 1024- vs 256-token prefill steps agree; prefill time +0.6 % (in the noise), decode unchanged; calls
# above 256 rows run as 256-row launches (16 MB FP64 scratch per rank; engine log 2026-11-18 04:15 and 04:35).
# run-lab.sh GATE_GEMV_ROWS=64 restores the GEMM.
# KV caches as exact packed records (VLLM_DEEPSEEK_V41_KV_PACK=1, plugin ops/sm80_kv_pack.py): window rows MXFP8 528 B,
# compressed rows NVFP4 288 B, index keys MXFP4 68 B (72 B stride) instead of BF16 rows of the same values
# (1024 / 1024 / 256 B). Every page is 36,864 B; the plugin sets the window block size to 64 rows itself (no flag).
# Outputs bitwise equal to the BF16 rows on the one-card PP harness (kvpack log 2026-11-19). run-lab.sh KV_PACK=0
# restores the BF16 rows. --kv-cache-pool-per-pp-stage (vLLM dsv41/stagepools): one block pool per set of PP
# stages, so a rank is charged only for the cache groups it holds. Packed records alone project ~540k tokens on
# rank 0 (global pool); with per-stage pools max-model-len 262144 (run-lab.sh MAX_MODEL_LEN / STAGE_POOLS=0).
# Candidate speed switches from vllm-sm80 left OFF for the first correctness boot (enable one at a
# time with benchlib): VLLM_DEEPSEEK_V41_ROUTER_MMA (its decode gate replaces the GEMV's),
# VLLM_DEEPSEEK_V41_SELECT_ONE_LAUNCH, VLLM_DEEPSEEK_V41_SWA_META_BATCH,
# VLLM_DEEPSEEK_V41_ATTN_PIPELINE, VLLM_DEEPSEEK_V41_SPLITKV_DECODE. (VLLM_DEEPSEEK_V41_FUSED_ATTN_DECODE is
# validated for 16 local heads, i.e. TP4; at TP=1 its gate stays closed.)
[Service]
Type=simple
Restart=no
TimeoutStartSec=600
TimeoutStopSec=90
ExecStartPre=-/usr/bin/docker rm -f dsv41-pp3-lab
ExecStart=/usr/bin/docker run --entrypoint '' -e PATH=/opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin --name dsv41-pp3-lab --gpus '"device=GPU-bd10e096-f7db-16a4-557b-06ea1b258c2e,GPU-a675b4e2-3df8-6b82-4ea5-7edb8eedc183,GPU-348909a8-87b2-f694-f624-59fcaa7a9255"' -e CUDA_VISIBLE_DEVICES=GPU-bd10e096-f7db-16a4-557b-06ea1b258c2e,GPU-a675b4e2-3df8-6b82-4ea5-7edb8eedc183,GPU-348909a8-87b2-f694-f624-59fcaa7a9255 --network host --shm-size 16g -e HF_HUB_OFFLINE=1 -v /home/alex/models/DeepSeek-V4.1-Flash-1017-Q4NX-c1:/model:ro -v /home/alex/models/DeepSeek-V4.1-Flash-1017-dense-w8-v1:/w8:ro -v /home/alex/models/DeepSeek-V4.1-Flash-1017-src:/engram:ro -e VLLM_PP_LAYER_PARTITION=15,10,15 -e VLLM_PP_HOMOGENEOUS_STEPS=1 -e VLLM_PP_SPREAD_DECODES=1 -e VLLM_EXL3_MOE_PREFILL_TC=1 -e VLLM_EXL3_MOE_DECODE_TC=1 -e VLLM_EXL3_MOE_DECODE_TC_MODE=full -e VLLM_EXL3_Q4N_PREFILL=i8 -e VLLM_EXL3_Q4N_I8_GEMM=t2c4 -e VLLM_EXL3_Q4N_DECODE=i8 -e VLLM_EXL3_Q4N_DECODE_GEMM=t2c4 -e VLLM_EXL3_MOE_DECODE_TC_MAX_ROWS=64 -e VLLM_EXL3_MOE_COMBINE_WIDE=1 -e VLLM_EXL3_ROUTE_CHECK=0 -e VLLM_EXL3_DENSE_PREFILL_TC=1 -e VLLM_EXL3_DENSE_DECODE_TC=1 -e VLLM_EXL3_DENSE_DECODE_TC_FAMILIES=all -e VLLM_EXL3_DENSE_DECODE_SPLITK=1 -e VLLM_EXL3_DECODE_VARIANT=off -e VLLM_EXL3_DENSE_W8=/w8/dense.safetensors -e VLLM_EXL3_DENSE_W8_DECODE=1 -e VLLM_DEEPSEEK_V41_DSPARK_EMBED_INT8=1 -e VLLM_DEEPSEEK_V41_DSPARK_EMBED_HOST=1 -e VLLM_DEEPSEEK_V41_EMBED_INT8=1 -e VLLM_DEEPSEEK_V41_TRIM_ROPE=1 -e VLLM_DEEPSEEK_V41_FUSED_MHC=1 -e VLLM_DEEPSEEK_V41_FUSED_MHC_FINISH=1 -e VLLM_DEEPSEEK_V41_FUSED_MHC_FINISH_V2=1 -e VLLM_SM80_MHC_UNIFORM_KERNEL_A=1 -e VLLM_DEEPSEEK_V41_GATE_GEMV=1 -e VLLM_DEEPSEEK_V41_GATE_GEMV_MAX_ROWS=2048 -e VLLM_DEEPSEEK_V41_KV_PACK=1 -e VLLM_ENGRAM_PLACEMENT=ssd -e VLLM_ENGRAM_ROW_CACHE_GIB=8 -e PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True lab-dsv41-pp3:PLUGIN_SHA vllm serve /model --host 127.0.0.1 --port 18560 --served-model-name deepseek-v4.1-flash-q4nx-lab --quantization exl3 --load-format exl3 --dtype bfloat16 --tokenizer-mode deepseek_v41 --pipeline-parallel-size 3 --tensor-parallel-size 1 --mm-encoder-tp-mode data --max-model-len 262144 --kv-cache-pool-per-pp-stage --max-num-seqs 4 --max-num-batched-tokens 2048 --prefill-chunk-with-decodes 2048 --gpu-memory-utilization 0.97 --enable-auto-tool-choice --tool-call-parser deepseek_v41 --reasoning-parser deepseek_v41 --enable-prompt-tokens-details --compilation-config '{"cudagraph_mode": "FULL_DECODE_ONLY"}' --hf-overrides '{"engram_table_dir": "/engram"}' --speculative-config '{"method": "dspark"}'
ExecStop=-/usr/bin/docker stop -t 45 dsv41-pp3-lab
ExecStopPost=-/usr/bin/docker rm -f dsv41-pp3-lab

[Install]
WantedBy=multi-user.target
